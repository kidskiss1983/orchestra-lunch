rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 請把實際管理者 Firebase Authentication UID 加進清單。
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "RhCxF66A4nTkjzzMERpThH7Mey03"
      ];
    }
    function signedIn(Anonymous) { return request.auth != null; }
    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/lunchEvents/$(eventId));
    }
    function eventOpen(eventId) {
      let e = get(/databases/$(database)/documents/lunchEvents/$(eventId)).data;
      return e.status == 'open' &&
        (!('deadline' in e) || e.deadline == '' || request.time < e.deadline);
    }
    function memberExists(memberId) {
      return exists(/databases/$(database)/documents/lunchMembers/$(memberId));
    }

    match /lunchEvents/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /lunchMembers/{memberId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /lunchOrders/{orderId} {
      // 家長只能查詢自己的訂單；管理者可讀取全部訂單。
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && !isAdmin() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.eventId is string &&
        request.resource.data.memberId is string &&
        eventExists(request.resource.data.eventId) &&
        eventOpen(request.resource.data.eventId) &&
        memberExists(request.resource.data.memberId) &&
        get(/databases/$(database)/documents/lunchMembers/$(request.resource.data.memberId)).data.active == true &&
        get(/databases/$(database)/documents/lunchMembers/$(request.resource.data.memberId)).data.name == request.resource.data.memberName &&
        orderId == request.resource.data.eventId + '_' + request.resource.data.memberId &&
        request.resource.data.items is list &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 500 &&
        request.resource.data.keys().hasOnly([
          'eventId','eventName','eventDate','memberId','memberName','items','note','ownerUid','createdAt','updatedAt'
        ]);
      allow update: if isAdmin() || (signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.memberId == resource.data.memberId &&
        eventOpen(resource.data.eventId));
      allow delete: if isAdmin();
    }

    // 預設拒絕所有未明確列出的集合。若未來要整合到原官網，請將本規則
    // 與原本規則合併，不要直接覆蓋舊規則。
    match /{document=**} { allow read, write: if false; }
  }
}
